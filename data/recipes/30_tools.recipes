# Tools (milestone 18 part 4): the familiar shapes, M = the tier's
# material, S = stick. A shape is also matched mirrored.

[recipe wooden_pickaxe]
shape = MMM / .S. / .S.
M = *_planks
S = stick
result = wooden_pickaxe

[recipe wooden_axe]
shape = MM / MS / .S
M = *_planks
S = stick
result = wooden_axe

[recipe wooden_shovel]
shape = M / S / S
M = *_planks
S = stick
result = wooden_shovel

[recipe wooden_hoe]
shape = MM / .S / .S
M = *_planks
S = stick
result = wooden_hoe

[recipe stone_pickaxe]
shape = MMM / .S. / .S.
M = cobblestone, mossy_cobblestone
S = stick
result = stone_pickaxe

