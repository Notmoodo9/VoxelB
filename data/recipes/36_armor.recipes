# Armor and shields (milestone 21 part 2). L = leather, M = the tier's
# material: its bars (light armor's trim), chain links (medium), plates
# (heavy, hammered at the Tinker's table); P = planks. Shapes match mirrored.

[recipe leather_helmet]
shape = LLL / L.L
L = leather
result = leather_helmet

[recipe leather_chestplate]
shape = L.L / LLL / LLL
L = leather
result = leather_chestplate

[recipe leather_leggings]
shape = LLL / L.L / L.L
L = leather
result = leather_leggings

[recipe leather_boots]
shape = L.L / L.L
L = leather
result = leather_boots

[recipe copper_chain_links]
