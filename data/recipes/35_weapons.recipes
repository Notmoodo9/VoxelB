# Melee weapons (milestone 21 part 1): M = the tier's material, S = stick
# (a shape also matches mirrored). Axes are with the tools.

[recipe wooden_sword]
shape = M / M / S
M = *_planks
S = stick
result = wooden_sword

[recipe wooden_spear]
shape = ..M / .S. / S..
M = *_planks
S = stick
result = wooden_spear

[recipe wooden_mace]
shape = MM / MM / S.
M = *_planks
S = stick
result = wooden_mace

[recipe stone_sword]
shape = M / M / S
M = cobblestone, mossy_cobblestone
S = stick
result = stone_sword

[recipe stone_spear]
shape = ..M / .S. / S..
M = cobblestone, mossy_cobblestone
S = stick
result = stone_spear

[recipe stone_mace]
shape = MM / MM / S.
M = cobblestone, mossy_cobblestone
S = stick
result = stone_mace

