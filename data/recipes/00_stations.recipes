# Crafting stations (milestone 18 part 3; format: DATA_FORMAT.md "Recipe
# files"). Right-clicking a station's block opens its crafting grid
# (sneak + right click places a block against it instead). Recipes without
# a `station` work by hand (2 x 2 in the inventory) and on any station
# whose grid is big enough; recipes with one need that station.

[station workbench]
block = workbench
grid = 3

# Containers: right click opens their slots; `joins`: two side by side
# with the same facing open as one container of twice the slots. Breaking
# one drops what is in it.
[container chest]
block = chest
slots = 27
joins = 1

# Furnaces: input, fuel, output; the block becomes `lit` while it burns.
# `speed` smelts (and burns fuel) that many times faster; `blast = 1` also
# smelts the [smelt] recipes marked blast (data/recipes/40_smelting.recipes).
[furnace furnace]
block = furnace
lit = furnace_lit
speed = 1

[furnace blast_furnace]
block = blast_furnace
lit = blast_furnace_lit
speed = 2
blast = 1

# The Tinker's table crafts like a workbench and repairs tools: a worn tool
# with 1-3 pairs of its repair material and binding (item files: `repair`,
# `binding`) gives a third of its durability back per pair.
[station tinkers_table]
block = tinkers_table
grid = 3
repair = 1

# Gravestones (milestone 20 part 2): right click gives back everything the
# player had when they died (each item into the slot it came from if that
# is empty), and the stone crumbles. The game places them (world.dat
# death = grave).
[grave gravestone]
block = gravestone
