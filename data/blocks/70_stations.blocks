# Crafting stations and containers (milestone 18 part 3,
# design/items/items_inventory.md). Right click uses them (data/recipes).

[block workbench]
textures = side: workbench_side, top: workbench_top, bottom: oak_planks

# a chest turns its front (the latch) towards the player who places it;
# two side by side with the same facing open as one large chest
[block chest]
shape    = facing
textures = side: chest_side, top: chest_top, bottom: chest_top, north: chest_front

# furnaces (milestone 18 part 4): the `_lit` block is shown while the fire
# burns (data/recipes: [furnace]); it glows warm and lights its corner
[block furnace]
shape    = facing
textures = side: furnace_side, top: furnace_top, bottom: furnace_top, north: furnace_front

[block furnace_lit]
shape    = facing
textures = side: furnace_side, top: furnace_top, bottom: furnace_top, north: furnace_front_lit
light    = 13, 8, 3

[block blast_furnace]
shape    = facing
textures = side: blast_furnace_side, top: blast_furnace_top, bottom: blast_furnace_top, north: blast_furnace_front

[block blast_furnace_lit]
shape    = facing
textures = side: blast_furnace_side, top: blast_furnace_top, bottom: blast_furnace_top, north: blast_furnace_front_lit
light    = 14, 9, 4

# the Tinker's table (milestone 18 part 4): a workbench with tool racks and
# a vise; it crafts like a workbench and repairs tools
[block tinkers_table]
textures = side: tinkers_table_side, top: tinkers_table_top, bottom: oak_planks
