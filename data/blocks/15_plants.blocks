# Plants (design/biomes/plains.md). `plant` is two crossed planes; a
# `tall_plant` is two blocks: state 0 the lower half, state 1 the upper half
# (upper_textures). Grass takes the biome's grass colour.

[template plant]
name     = {}
shape    = plant
textures = {}
render   = cutout
sway     = 1

[block short_grass]
shape    = plant
textures = short_grass
render   = cutout
sway     = 1
tint     = grass

[block tall_grass]
shape          = tall_plant
textures       = tall_grass_lower
upper_textures = tall_grass_upper
render         = cutout
sway           = 1
tint           = grass

[family flowers]
templates = plant
members   = poppy, dandelion, cornflower, oxeye_daisy, allium, red_tulip, orange_tulip, white_tulip, pink_tulip

# forest floor (design/biomes/forest.md)
[block fern]
shape    = plant
textures = fern
render   = cutout
sway     = 1
tint     = grass

[family mushrooms_small]
templates = plant
members   = red_mushroom, brown_mushroom

# birch grove flowers (design/biomes/birch_grove.md)
[family spring_flowers]
templates = plant
members   = lily_of_the_valley, bluebell, wood_anemone

# desert (design/biomes/desert.md)
[block dead_bush]
shape    = plant
textures = dead_bush
render   = cutout
sway     = 1

# sits on top of a cactus
[block cactus_flower]
shape    = plant
textures = cactus_flower
render   = cutout

# taiga (design/biomes/taiga.md)
[block berry_bush]
shape    = plant
textures = berry_bush
render   = cutout
sway     = 1

# snowy tundra (design/biomes/snowy_tundra.md)
[family tundra_shrubs]
templates = plant
members   = dwarf_shrub, lingonberry_shrub

# steppe (design/biomes/steppe.md)
[block feather_grass]
shape          = tall_plant
textures       = feather_grass_lower
upper_textures = feather_grass_upper
render         = cutout
sway           = 1

[family steppe_plants]
templates = plant
members   = sagebrush, blue_sage, yarrow, pasqueflower

# swamp (design/biomes/swamp.md)
[block spanish_moss]
shape    = plant
textures = spanish_moss
render   = cutout
sway     = 1

# floating on the water surface (thin plate)
[block lily_pad]
shape    = pressure_plate
textures = lily_pad
render   = cutout

[block flowering_lily_pad]
shape    = pressure_plate
textures = flowering_lily_pad
render   = cutout

[block cattail]
shape          = tall_plant
textures       = cattail_lower
upper_textures = cattail_upper
render         = cutout
sway           = 1

[block reeds]
shape    = plant
textures = reeds
render   = cutout
sway     = 1

# dark forest (design/biomes/dark_forest.md): softly glowing mushrooms
# (the glow layer reads bright now; real block light arrives in M13)
[block glowcap]
shape    = plant
textures = glowcap
render   = cutout
