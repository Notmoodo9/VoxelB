# Soils, surface and the stone family (design/blocks/block_set.md).
# Format: DATA_FORMAT.md, "Block files". A block with no `textures` uses
# the texture with its own name on every face.

# --- soils & surface --------------------------------------------------------
[block dirt]

[block grass_block]
textures = side: grass_block_side, top: grass_block_top, bottom: dirt

[block coarse_dirt]
[block sand]
[block red_sand]
[block gravel]
[block clay]
[block mud]
[block snow]

[block forest_floor]
textures = side: forest_floor_side, top: forest_floor_top, bottom: dirt

# --- stone family -------------------------------------------------------------
[block stone]
[block cobblestone]
[block mossy_cobblestone]
[block smooth_stone]
[block stone_bricks]
[block deep_stone]
[block bedrock]

[block sandstone]
textures = side: sandstone, top: sandstone_top, bottom: sandstone_bottom

# --- water (still for now; flowing water and reflections arrive in M15) ---
[block water]
render = translucent

# soft moss ground of old-growth forests
[block moss_block]

# an old oak stump overgrown with moss
[block mossy_oak_log]
shape    = axis
textures = side: mossy_oak_log, end: oak_log_top

# desert (design/biomes/desert.md)
[block cactus]
textures = side: cactus, end: cactus_top

[block bone_block]
textures = side: bone_block, end: bone_block_top

# taiga: spruce needles over dirt near the trunks
[block spruce_needle_floor]
textures = side: spruce_needle_floor_side, top: spruce_needle_floor_top, bottom: dirt

# savanna termite mounds
[block termite_mound]

# badlands (design/biomes/badlands.md): bleached dead tree wood
[block dead_wood]
shape    = axis
textures = side: dead_wood, end: dead_wood_top

# steppe salt flats (design/biomes/steppe.md)
[block salt]
