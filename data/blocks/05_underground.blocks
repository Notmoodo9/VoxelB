# Underground blocks (design/terrain/underground.md).

[block lava]
light = 15, 8, 2

[block dripstone_block]

# pointed dripstone: state 0 points up (stalagmite), 1 points down
# (stalactite); it tapers automatically into base, middle and tip
[block pointed_dripstone]
shape  = spike
render = cutout

# --- ores (deep_ variants sit in deep stone) ----------------------------------
[block coal_ore]
[block copper_ore]
[block deep_copper_ore]
[block iron_ore]
[block deep_iron_ore]
[block silver_ore]
[block deep_silver_ore]
[block gold_ore]
[block deep_gold_ore]
[block emerald_ore]
[block diamond_ore]
[block mythril_ore]
[block adamantite_ore]

[block star_crystal_ore]
light = 12, 11, 6

# --- crystal caves (design/biomes/crystal_caves.md) ----------------------------
# near-black rock with glowing veins in the grotto's colour
[template veined_stone]
name = {}_veined_stone

[family veined_stones]
templates = veined_stone
members   = blue, purple, green, pink, amber

# crystal sprouts: the spike shape (state 0 points up from floors, 1 hangs
# from ceilings) with the crystal's own glowing texture
[template crystal_sprout]
name     = {}_crystal_sprout
shape    = spike
render   = cutout
textures = {}_crystal

[family crystal_sprouts]
templates = crystal_sprout
members   = blue, purple, green, pink, amber

# still, luminous pools (a block, not a flowing liquid, until fluids come)
[template glow_pool]
name     = {}_glow_pool
render   = translucent

[family glow_pools]
templates = glow_pool
members   = blue, purple, green, pink, amber

# their light (milestone 13): the grotto's colour, a little dimmer than the
# crystal blocks (data/blocks/50_lights.blocks)
[block blue_crystal_sprout]
light = 3, 6, 10
[block purple_crystal_sprout]
light = 8, 3, 10
[block green_crystal_sprout]
light = 3, 10, 6
[block pink_crystal_sprout]
light = 10, 4, 8
[block amber_crystal_sprout]
light = 10, 7, 2
[block blue_glow_pool]
light = 3, 7, 11
[block purple_glow_pool]
light = 8, 3, 11
[block green_glow_pool]
light = 3, 11, 6
[block pink_glow_pool]
light = 11, 4, 9
[block amber_glow_pool]
light = 11, 8, 2

