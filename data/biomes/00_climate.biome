# Climate fields and colour references (design/biomes/biome_system.md).
# Temperature and humidity are 0..1: 0.5 + noise * contrast, clamped.
# Bigger scale = bigger climate zones = bigger biomes.

[climate]
# the average colours of the grass and oak leaf textures: a biome colour
# equal to these leaves the texture unchanged
grass_reference   = 56CA42
foliage_reference = 389D24
contrast          = 1.0

[noise temperature]
scale       = 1100
octaves     = 2
persistence = 0.5
salt        = 301

[noise humidity]
scale       = 900
octaves     = 2
persistence = 0.5
salt        = 302

# rare pockets (old-growth hearts): biomes with a `weirdness` range
[noise weirdness]
scale       = 500
octaves     = 2
persistence = 0.5
salt        = 303

# dune crests (desert `dune_height`): ridged, crests ~90 blocks apart
[noise dunes]
scale       = 90
octaves     = 2
persistence = 0.45
ridged      = 1
salt        = 304

# plateaus (savanna `plateau_height`): flat tops where this is above ~0.22
[noise plateaus]
scale       = 300
octaves     = 2
persistence = 0.4
salt        = 305

# mesas (badlands `mesa_height`): terraced where this is above 0
[noise mesas]
scale       = 200
octaves     = 3
persistence = 0.45
salt        = 306

# the slow wave of the badlands bands (a few blocks up and down)
[noise strata]
scale       = 260
octaves     = 2
persistence = 0.5
salt        = 307

# rare pockets that the weirdness bands cannot give (the glowing forest):
# biomes with a `rarity` range at its far end
[noise rarity]
scale       = 450
octaves     = 2
persistence = 0.5
salt        = 308
