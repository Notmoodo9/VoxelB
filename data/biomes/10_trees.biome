# Tree and bush generators. Biomes refer to them by name, so they come
# first (files load in name order).
#   kind      round (trunk + round crown), branching (trunk, diagonal branches
#             with leaf clusters, crown), bush (log stub + low leaf clump)
#   height    trunk height range;  radius  crown radius range
#   branches  branch count range (branching);  leaf_gaps  chance that an
#             edge leaf is left out (irregular crowns)

# plains: small round oaks (5-7 tall)
[tree small_oak]
kind      = round
log       = oak_log
leaves    = oak_leaves
height    = 4, 6
radius    = 2.0, 2.8
leaf_gaps = 0.3

# plains: occasional big branching oaks (10-14 tall)
[tree big_oak]
kind      = branching
log       = oak_log
leaves    = oak_leaves
height    = 8, 11
radius    = 2.8, 3.4
branches  = 2, 4
leaf_gaps = 0.35

[tree oak_bush]
kind      = bush
log       = oak_log
leaves    = oak_leaves
height    = 1, 1
radius    = 1.4, 2.1
leaf_gaps = 0.3

[tree flowering_bush]
kind      = bush
log       = oak_log
leaves    = flowering_oak_leaves
height    = 1, 1
radius    = 1.4, 2.1
leaf_gaps = 0.3

# --- forest (design/biomes/forest.md) -----------------------------------------
# tall, slim birches with a light crown
[tree birch]
kind      = round
log       = birch_log
leaves    = birch_leaves
height    = 7, 10
radius    = 1.6, 2.2
leaf_gaps = 0.3

# medium maples with wide round crowns, green or in autumn colours
[tree maple]
kind      = round
log       = maple_log
leaves    = maple_leaves
height    = 4, 6
radius    = 2.8, 3.4
leaf_gaps = 0.25

[tree autumn_maple]
kind      = round
log       = maple_log
leaves    = maple_autumn_leaves
height    = 4, 6
radius    = 2.8, 3.4
leaf_gaps = 0.25

# a log lying on the forest floor (length range in `height`)
[tree fallen_oak]
kind      = fallen
log       = oak_log
height    = 3, 6

[tree mossy_stump]
kind      = stump
log       = mossy_oak_log
height    = 1, 2

# --- old-growth forest (design/biomes/old_growth_forest.md) --------------------
#   giant: trunk discs taper from base_radius (flared at the ground) to 3 x 3
#   at the crown base (55% up), with `roots` arching roots and `branches`
#   heavy branches each ending in a leaf cluster of `radius`
[tree giant_oak]
kind        = giant
log         = oak_log
leaves      = oak_leaves
height      = 30, 65
radius      = 4.5, 6.5
branches    = 6, 10
base_radius = 3.5, 5.0
roots       = 4, 7
leaf_gaps   = 0.3

# a huge mossy fallen giant
[tree fallen_giant]
kind      = fallen
log       = mossy_oak_log
height    = 7, 12

# --- birch grove (design/biomes/birch_grove.md) --------------------------------
[tree fallen_birch]
kind      = fallen
log       = birch_log
height    = 3, 5

# --- desert (design/biomes/desert.md) --------------------------------------
#   cactus: column of `height`, arms from `branches`, flower (`leaves`) on top
#   with `chance`
[tree cactus]
kind     = cactus
log      = cactus
leaves   = cactus_flower
height   = 2, 5
branches = 0, 2
chance   = 0.7

#   rock: discs shrinking upward from a base of `radius`, `height` tall
[tree sandstone_boulder]
kind   = rock
log    = sandstone
radius = 1.5, 3.0
height = 2, 4

[tree sandstone_spire]
kind   = rock
log    = sandstone
radius = 1.5, 2.5
height = 6, 12

#   arch: a half-ring of `radius`, legs into the ground
[tree sandstone_arch]
kind   = arch
log    = sandstone
radius = 6, 10
height = 1, 1

#   fossil: a half-buried spine `height` long with ribs
[tree fossil]
kind   = fossil
log    = bone_block
height = 6, 10

#   palm: curved trunk of `height`, fronds of `radius` length
[tree palm]
kind   = palm
log    = palm_log
leaves = palm_leaves
height = 6, 10
radius = 3, 4.5

# --- taiga (design/biomes/taiga.md) ----------------------------------------
#   conifer: trunk of `height`, needles from a quarter up in tiers shrinking
#   from `radius` to a tip (every second layer smaller)
[tree spruce]
kind      = conifer
log       = spruce_log
leaves    = spruce_leaves
height    = 8, 16
radius    = 2.5, 3.2
leaf_gaps = 0.25

[tree snowy_spruce]
kind      = conifer
log       = spruce_log
leaves    = spruce_snowy_leaves
height    = 7, 14
radius    = 2.3, 3.0
leaf_gaps = 0.25

#   rock with `leaves` as the block on its upper half (moss)
[tree mossy_boulder]
kind   = rock
log    = cobblestone
leaves = mossy_cobblestone
radius = 1.5, 2.5
height = 2, 3

[tree fallen_spruce]
kind   = fallen
log    = spruce_log
height = 4, 7

# --- savanna (design/biomes/savanna.md) ------------------------------------
#   acacia: trunk of `height` forking into 2 limbs with flat leaf pads of
#   `radius`
[tree acacia]
kind      = acacia
log       = acacia_log
leaves    = acacia_leaves
height    = 4, 6
radius    = 2.5, 3.5
leaf_gaps = 0.3

#   baobab: fat bottle trunk (`base_radius`), `branches` stubby branches
#   with leaf tufts of `radius`
[tree baobab]
kind        = baobab
log         = acacia_log
leaves      = acacia_leaves
height      = 10, 16
base_radius = 1.5, 2.5
branches    = 5, 8
radius      = 1.4, 2.0
leaf_gaps   = 0.3

[tree termite_mound]
kind   = rock
log    = termite_mound
radius = 1.2, 2.0
height = 3, 6

# --- jungle (design/biomes/jungle.md) ----------------------------------------
#   vines = block, chance per trunk side (a run hanging from below the crown)
#   hanging_vines = block, chance per leaf (a strand hanging to the ground)
#   fungus = block, chance per trunk side;  pods = block, chance per tree
#   vine_length = length range of vine runs and strands
# mid-canopy jungle tree: crowns touch to close the canopy
[tree jungle_tree]
kind          = branching
log           = jungle_log
leaves        = jungle_leaves
height        = 12, 20
radius        = 3.5, 5.0
branches      = 2, 4
leaf_gaps     = 0.15
vines         = vine, 0.45
hanging_vines = hanging_vine, 0.025
vine_length   = 3, 12
fungus        = shelf_fungus, 0.06
pods          = cocoa_pod, 0.25

#   kapok: buttress fins (`roots`), a bare trunk of `base_radius`, `branches`
#   thick branches ending in wide flat clusters of `radius`
[tree kapok]
kind          = kapok
log           = jungle_log
leaves        = jungle_leaves
height        = 30, 45
base_radius   = 1.0, 1.5
roots         = 4, 6
branches      = 4, 7
radius        = 4.0, 6.0
leaf_gaps     = 0.2
vines         = vine, 0.6
hanging_vines = hanging_vine, 0.02
vine_length   = 4, 16
fungus        = shelf_fungus, 0.35

[tree jungle_bush]
kind          = bush
log           = jungle_log
leaves        = jungle_leaves
radius        = 1.5, 2.5
leaf_gaps     = 0.25

#   grove: a disc of `radius` with stalks (`log`) on a share `chance` of the
#   columns, `height` tall, each with a tuft (`leaves`) on top
[tree bamboo_grove]
kind          = grove
log           = bamboo
leaves        = bamboo_leaves
height        = 6, 14
radius        = 7.5, 20
chance        = 0.45

# --- snowy tundra (design/biomes/snowy_tundra.md) ----------------------------
[tree stunted_spruce]
kind      = conifer
log       = spruce_log
leaves    = spruce_snowy_leaves
height    = 4, 7
radius    = 1.2, 1.8
leaf_gaps = 0.25

# snow-capped boulders: stone with a snow upper half
[tree tundra_boulder]
kind   = rock
log    = stone
leaves = snow
radius = 1.0, 2.0
height = 2, 3

[tree big_tundra_boulder]
kind   = rock
log    = cobblestone
leaves = snow
radius = 2.5, 3.0
height = 3, 5

# low, wide snow mounds
[tree snow_drift]
kind   = rock
log    = snow
radius = 2.0, 3.5
height = 1, 2

# --- badlands (design/biomes/badlands.md) ------------------------------------
#   log = strata: each block takes the band of the local biome at its height
# bleached, twisted dead tree: a forked trunk with crooked limbs, no leaves
[tree dead_tree]
kind     = acacia
log      = dead_wood
height   = 4, 8
radius   = 0, 0

[tree hoodoo]
kind   = rock
log    = strata
radius = 1.2, 2.2
height = 8, 20

[tree striped_arch]
kind   = arch
log    = strata
radius = 7, 11
height = 1, 1

[tree badlands_boulder]
kind   = rock
log    = strata
radius = 1.2, 2.2
height = 2, 3

# --- steppe (design/biomes/steppe.md) ----------------------------------------
#   lean: blocks east per block of height (a prevailing wind)
[tree windswept_birch]
kind      = round
log       = birch_log
leaves    = birch_leaves
height    = 5, 8
radius    = 1.8, 2.6
leaf_gaps = 0.3
lean      = 0.3

[tree steppe_outcrop]
kind   = rock
log    = stone
leaves = cobblestone
radius = 2.0, 4.0
height = 1, 3

[tree menhir]
kind   = rock
log    = stone
radius = 0.6, 0.9
height = 3, 6

#   stone_ring: `branches` stones on a ring of `radius`, `height` tall,
#   `leaves` = the top block
[tree stone_circle]
kind     = stone_ring
log      = stone
leaves   = mossy_cobblestone
radius   = 5, 8
height   = 3, 5
branches = 6, 10

# --- swamp (design/biomes/swamp.md) ------------------------------------------
#   cypress: trunk flared to `base_radius` at the water line, `height` tall,
#   3 flat crown layers of `radius`, `roots` knees around it
[tree bald_cypress]
kind          = cypress
log           = mangrove_log
leaves        = mangrove_leaves
height        = 10, 18
base_radius   = 1.4, 1.9
radius        = 3.2, 4.4
roots         = 1, 3
leaf_gaps     = 0.35
hanging_vines = spanish_moss, 0.05
vine_length   = 2, 6
