# Tree and bush generators. Biomes refer to them by name, so they come
# first (files load in name order).
#   kind      round (trunk + round crown), branching (trunk, diagonal branches
#             with leaf clusters, crown), bush (log stub + low leaf clump)
#   height    trunk height range;  radius  crown radius range
#   branches  branch count range (branching);  leaf_gaps  chance that an
#             edge leaf is left out (irregular crowns)

# plains: small round oaks (5-7 tall)
[tree small_oak]
kind      = round
log       = oak_log
leaves    = oak_leaves
height    = 4, 6
radius    = 2.0, 2.8
leaf_gaps = 0.3

# plains: occasional big branching oaks (10-14 tall)
[tree big_oak]
kind      = branching
log       = oak_log
leaves    = oak_leaves
height    = 8, 11
radius    = 2.8, 3.4
branches  = 2, 4
leaf_gaps = 0.35

[tree oak_bush]
kind      = bush
log       = oak_log
leaves    = oak_leaves
height    = 1, 1
radius    = 1.4, 2.1
leaf_gaps = 0.3

[tree flowering_bush]
kind      = bush
log       = oak_log
leaves    = flowering_oak_leaves
height    = 1, 1
radius    = 1.4, 2.1
leaf_gaps = 0.3

# --- forest (design/biomes/forest.md) -----------------------------------------
# tall, slim birches with a light crown
[tree birch]
kind      = round
log       = birch_log
leaves    = birch_leaves
height    = 7, 10
radius    = 1.6, 2.2
leaf_gaps = 0.3

# medium maples with wide round crowns, green or in autumn colours
[tree maple]
kind      = round
log       = maple_log
leaves    = maple_leaves
height    = 4, 6
radius    = 2.8, 3.4
leaf_gaps = 0.25

[tree autumn_maple]
kind      = round
log       = maple_log
leaves    = maple_autumn_leaves
height    = 4, 6
radius    = 2.8, 3.4
leaf_gaps = 0.25

# a log lying on the forest floor (length range in `height`)
[tree fallen_oak]
kind      = fallen
log       = oak_log
height    = 3, 6

[tree mossy_stump]
kind      = stump
log       = mossy_oak_log
height    = 1, 2

# --- old-growth forest (design/biomes/old_growth_forest.md) --------------------
#   giant: trunk discs taper from base_radius (flared at the ground) to 3 x 3
#   at the crown base (55% up), with `roots` arching roots and `branches`
#   heavy branches each ending in a leaf cluster of `radius`
[tree giant_oak]
kind        = giant
log         = oak_log
leaves      = oak_leaves
height      = 30, 65
radius      = 4.5, 6.5
branches    = 6, 10
base_radius = 3.5, 5.0
roots       = 4, 7
leaf_gaps   = 0.3

# a huge mossy fallen giant
[tree fallen_giant]
kind      = fallen
log       = mossy_oak_log
height    = 7, 12

# --- birch grove (design/biomes/birch_grove.md) --------------------------------
[tree fallen_birch]
kind      = fallen
log       = birch_log
height    = 3, 5

# --- desert (design/biomes/desert.md) --------------------------------------
#   cactus: column of `height`, arms from `branches`, flower (`leaves`) on top
#   with `chance`
[tree cactus]
kind     = cactus
log      = cactus
leaves   = cactus_flower
height   = 2, 5
branches = 0, 2
chance   = 0.7

#   rock: discs shrinking upward from a base of `radius`, `height` tall
[tree sandstone_boulder]
kind   = rock
log    = sandstone
radius = 1.5, 3.0
height = 2, 4

[tree sandstone_spire]
kind   = rock
log    = sandstone
radius = 1.5, 2.5
height = 6, 12

#   arch: a half-ring of `radius`, legs into the ground
[tree sandstone_arch]
kind   = arch
log    = sandstone
radius = 6, 10
height = 1, 1

#   fossil: a half-buried spine `height` long with ribs
[tree fossil]
kind   = fossil
log    = bone_block
height = 6, 10

#   palm: curved trunk of `height`, fronds of `radius` length
[tree palm]
kind   = palm
log    = palm_log
leaves = palm_leaves
height = 6, 10
radius = 3, 4.5

# --- taiga (design/biomes/taiga.md) ----------------------------------------
#   conifer: trunk of `height`, needles from a quarter up in tiers shrinking
#   from `radius` to a tip (every second layer smaller)
[tree spruce]
kind      = conifer
log       = spruce_log
leaves    = spruce_leaves
height    = 8, 16
radius    = 2.5, 3.2
leaf_gaps = 0.25

[tree snowy_spruce]
kind      = conifer
log       = spruce_log
leaves    = spruce_snowy_leaves
height    = 7, 14
radius    = 2.3, 3.0
leaf_gaps = 0.25

#   rock with `leaves` as the block on its upper half (moss)
[tree mossy_boulder]
kind   = rock
log    = cobblestone
leaves = mossy_cobblestone
radius = 1.5, 2.5
height = 2, 3

[tree fallen_spruce]
kind   = fallen
log    = spruce_log
height = 4, 7
