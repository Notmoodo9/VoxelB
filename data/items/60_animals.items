# the bucket scoops a water or lava source (fill = source block, filled
# item) and milks cows and goats (data/mobs: milk); a full bucket pours its
# block and leaves the empty bucket (leaves)
[item bucket]
texture = bucket
stack = 16
tab = tools
fill = water, water_bucket
fill = lava, lava_bucket

[item water_bucket]
title = Bucket of water
texture = water_bucket
stack = 1
block = water
leaves = bucket
tab = tools

[item lava_bucket]
title = Bucket of lava
texture = lava_bucket
stack = 1
block = lava
leaves = bucket
tab = tools

