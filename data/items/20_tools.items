# Tools (milestone 18 part 4, design/items/items_inventory.md): the four
# tool types in 8 tiers. `speed` divides the mining time of blocks that
# want this tool; `tier` decides what drops (mining.cfg); `durability` is
# the number of blocks a tool breaks before it breaks itself. Pictures:
# assets/textures/items/<name>.png (tools/texgen/itemgen.py).
# `repair` and `binding`: what a Tinker's table repairs it with (one of
# each restores a third of its durability; up to 3 pairs at once).

# ---- wooden ----
[item wooden_pickaxe]
title = Wooden pickaxe
texture = wooden_pickaxe
tab = tools
stack = 1
tool = pickaxe
tier = wood
repair = *_planks
binding = fibre_binding
speed = 2
durability = 60

[item wooden_axe]
title = Wooden axe
texture = wooden_axe
tab = tools
stack = 1
tool = axe
tier = wood
repair = *_planks
binding = fibre_binding
speed = 2
durability = 60

[item wooden_shovel]
title = Wooden shovel
texture = wooden_shovel
tab = tools
stack = 1
tool = shovel
tier = wood
repair = *_planks
binding = fibre_binding
speed = 2
durability = 60

[item wooden_hoe]
title = Wooden hoe
texture = wooden_hoe
tab = tools
stack = 1
tool = hoe
tier = wood
repair = *_planks
binding = fibre_binding
speed = 2
durability = 60

