# Materials that are not blocks (milestone 18): what ores drop. Pictures:
# assets/textures/items/<texture>.png, drawn by tools/texgen/itemgen.py.

[item coal]
texture = coal
tab = items

[item diamond]
texture = diamond
tab = items

[item emerald]
texture = emerald
tab = items

[item star_crystal]
texture = star_crystal
tab = items

# crafting (milestone 18 part 3)
[item stick]
texture = stick
tab = items

# metal bars: smelted from their ores (the furnace; mythril and adamantite
# need the blast furnace)
[item copper_bar]
texture = copper_bar
tab = items

[item iron_bar]
texture = iron_bar
tab = items

[item silver_bar]
texture = silver_bar
tab = items

[item gold_bar]
texture = gold_bar
tab = items

[item mythril_bar]
texture = mythril_bar
tab = items

[item adamantite_bar]
texture = adamantite_bar
tab = items

# a burning furnace shows as its plain self (titles in the furnace window)
[item furnace_lit]
title = Furnace

[item blast_furnace_lit]
title = Blast furnace

# ---- repairs (milestone 18 part 4): bindings and what they are made of ----
# plant fibre: sometimes from grass, ferns, vines and reeds; resin:
# sometimes from logs; crystal shards: from crystal sprouts (mining.cfg)
[item plant_fibre]
texture = plant_fibre
tab = items

[item resin]
texture = resin
tab = items

[item crystal_shard]
texture = crystal_shard
tab = items

# a tool's binding (Tinker's table): wood, stone, copper tools
[item fibre_binding]
texture = fibre_binding
tab = items

# iron and diamond tools
[item flux]
texture = flux
tab = items

# mythril, adamantite and star crystal tools
[item star_essence]
texture = star_essence
tab = items
