# Armor and shields (milestone 21 part 2, design/combat/combat.md).
# `armor` = where it is worn (head, chest, legs, feet; shield: held in the
# off hand); `protection` = points (a set's points split 15 / 40 / 30 /
# 15 %; 20 points in all block 80 % of the damage armor stops); `weight` =
# light (no slowdown), medium (slightly slower) or heavy (slower, hungrier,
# no dodge roll). Durability: hits taken. Light = leather trimmed with the
# tier's metal, medium = chainmail, heavy = plate. Repaired at the
# Tinker's table with the tier's material and binding.
# Pictures: assets/textures/items/<name>.png (tools/texgen/itemgen.py).

# ---- leather (light) ----
[item leather_helmet]
title = Leather cap
texture = leather_helmet
tab = combat
stack = 1
armor = head
protection = 1
weight = light
durability = 44
repair = leather
binding = fibre_binding

[item leather_chestplate]
title = Leather tunic
texture = leather_chestplate
tab = combat
stack = 1
armor = chest
protection = 2
weight = light
durability = 64
repair = leather
binding = fibre_binding

[item leather_leggings]
title = Leather trousers
texture = leather_leggings
tab = combat
stack = 1
armor = legs
protection = 1.5
weight = light
durability = 60
repair = leather
binding = fibre_binding

[item leather_boots]
title = Leather boots
texture = leather_boots
tab = combat
stack = 1
armor = feet
protection = 1
weight = light
durability = 52
repair = leather
binding = fibre_binding

