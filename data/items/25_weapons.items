# Melee weapons (milestone 21 part 1, design/combat/combat.md): swords,
# spears and maces in the 8 tiers (axes are in 20_tools.items: they chop
# and fight). `weapon` = the kind; `damage` = health points a full swing
# takes; `swing` = seconds the swing meter takes to fill (a hit before it is
# full does damage x (0.2 + 0.8 x meter^2)); `knockback` x the usual push;
# `reach` = extra blocks of reach. Weapons wear 1 per hit and are repaired
# at the Tinker's table like tools (`repair`, `binding`).
# Pictures: assets/textures/items/<name>.png (tools/texgen/itemgen.py).

# ---- wooden ----
[item wooden_sword]
title = Wooden sword
texture = wooden_sword
tab = combat
stack = 1
weapon = sword
tier = wood
damage = 4
swing = 0.6
repair = *_planks
binding = fibre_binding
durability = 60

[item wooden_spear]
title = Wooden spear
texture = wooden_spear
tab = combat
stack = 1
weapon = spear
tier = wood
damage = 3.5
swing = 0.55
knockback = 0.7
reach = 1
repair = *_planks
binding = fibre_binding
durability = 60

[item wooden_mace]
title = Wooden mace
texture = wooden_mace
tab = combat
stack = 1
weapon = mace
tier = wood
damage = 6
swing = 1.4
knockback = 2
repair = *_planks
binding = fibre_binding
durability = 60

