# Pigs and wild boars (milestone 19 part 3, design/mobs/passive_animals.md).
# Format: DATA_FORMAT.md "Mob files". Boars are `fierce`: hit one and it
# charges back.

[model pig]
skin_size = 64 64
part = body,   none, 0 6 0,     -5 0 -8,    10 8 16,    0 0
part = head,   head, 0 11 -8,   -4 -4 -7,   8 8 7,      0 24
part = snout,  head, 0 11 -8,   -2 -3 -8,   4 3 1,      30 24
part = ear_l,  head, 0 11 -8,   -4 3 -4,    2 2 1,      40 24
part = ear_r,  head, 0 11 -8,   2 3 -4,     2 2 1,      40 24
part = leg_fl, leg0, -3 6 -5,   -1.5 -6 -1.5, 3 6 3,    0 39
part = leg_fr, leg1, 3 6 -5,    -1.5 -6 -1.5, 3 6 3,    0 39
part = leg_bl, leg1, -3 6 5,    -1.5 -6 -1.5, 3 6 3,    0 39
part = leg_br, leg0, 3 6 5,     -1.5 -6 -1.5, 3 6 3,    0 39
part = tail,   tail, 0 12 8,    -0.5 -2 0,  1 2 1,      46 24

# the wild boar: tusks and a bristly ridge along the back
[model boar]
skin_size = 64 64
part = body,   none, 0 6 0,     -5 0 -8,    10 8 16,    0 0
part = mane,   none, 0 14 0,    -1 0 -7,    2 2 12,     12 39
part = head,   head, 0 11 -8,   -4 -4 -7,   8 8 7,      0 24
part = snout,  head, 0 11 -8,   -2 -3 -8,   4 3 1,      30 24
part = tusk_l, head, 0 11 -8,   -3 -3 -8.5, 1 2 1,      50 24
part = tusk_r, head, 0 11 -8,   2 -3 -8.5,  1 2 1,      50 24
part = ear_l,  head, 0 11 -8,   -4 3 -4,    2 2 1,      40 24
part = ear_r,  head, 0 11 -8,   2 3 -4,     2 2 1,      40 24
part = leg_fl, leg0, -3 6 -5,   -1.5 -6 -1.5, 3 6 3,    0 39
part = leg_fr, leg1, 3 6 -5,    -1.5 -6 -1.5, 3 6 3,    0 39
part = leg_bl, leg1, -3 6 5,    -1.5 -6 -1.5, 3 6 3,    0 39
part = leg_br, leg0, 3 6 5,     -1.5 -6 -1.5, 3 6 3,    0 39
part = tail,   tail, 0 12 8,    -0.5 -3 0,  1 3 1,      46 24

[mob pig]
health = 10
size = 0.9 0.9
speed = 1.2
temper = calm
food = carrot, berries
drop = pork, 1, 3
variant = pink, pig_pink, pig

[mob boar]
title = wild boar
health = 14
size = 0.9 0.9
speed = 1.4
temper = fierce
food = carrot, berries
drop = pork, 1, 3
variant = wild, boar_wild, boar

[spawn]
mob = pig
biomes = plains, meadow
chance = 5
herd = 2, 4

[spawn]
mob = pig
biomes = forest
chance = 2
herd = 2, 3

[spawn]
mob = boar
biomes = forest, dark_forest, old_growth_forest, jungle
chance = 4
herd = 2, 4
