#version 450 core
// Cascaded shadow maps (milestone 14 part 2): one thread works out the
// light's view-projection for every cascade and writes them, with the split
// distances and the light, into the shadow data buffer that the shadow pass
// (chunk.vert) and the world shader (chunk.frag) read.
//
// Each cascade covers the slice [split k-1, split k] of the camera's view by
// its bounding sphere, so its size never changes with the view direction,
// and its centre is snapped to whole shadow texels in world-anchored light
// space, so the edges don't shimmer as the camera moves. Light space is
// camera-relative like everything else; reverse-Z: depth 1 nearest the
// light (depth clamping keeps casters beyond the box).

layout(local_size_x = 1) in;

struct ShadowData {
    mat4 m[4];        // camera-relative position -> light clip space
    vec4 splits;      // far distance of each cascade (blocks)
    vec4 light;       // xyz towards the light (sun or moon), w strength 0..1
    vec4 texel;       // world size of one texel per cascade
    vec4 origin[4];   // camera position (mod 4096) when each cascade was drawn
};
layout(std430, binding = 7) buffer Shadow { ShadowData sd; };

layout(location = 0) uniform mat4 u_viewproj;   // the camera (rotation + projection)
layout(location = 4) uniform vec3 u_sun;        // towards the sun
layout(location = 5) uniform vec4 u_splits;     // cascade far distances
layout(location = 6) uniform float u_res;       // shadow map size (texels)
layout(location = 7) uniform vec3 u_cam_mod;    // camera position (mod 4096: snapping)
layout(location = 8) uniform int u_cascades;
layout(location = 9) uniform int u_update;      // cascades redrawn this frame (bits)

const float DEPTH_RANGE = 640.0;   // blocks towards / away from the light

void main() {
    // the light: the sun by day, the moon (opposite) by night; it fades
    // out near the horizon, where the shadows would stretch forever
    vec3 sun = normalize(u_sun);
    vec3 l = sun.y >= 0.0 ? sun : -sun;
    float strength = smoothstep(0.03, 0.20, l.y) * (sun.y >= 0.0 ? 1.0 : 0.5);
    if (l.y < 0.12) {            // keep the light at least ~7 degrees high
        l.y = 0.12;
        l = normalize(l);
    }
    sd.light = vec4(l, strength);
    sd.splits = u_splits;

    // the camera's rays through the 4 screen corners and its forward axis
    mat4 inv = inverse(u_viewproj);
    vec4 f4 = inv * vec4(0.0, 0.0, 0.5, 1.0);
    vec3 fwd = normalize(f4.xyz / f4.w);
    vec3 rays[4];
    for (int i = 0; i < 4; ++i) {
        vec2 ndc = vec2((i & 1) != 0 ? 1.0 : -1.0, (i & 2) != 0 ? 1.0 : -1.0);
        vec4 w = inv * vec4(ndc, 0.5, 1.0);
        vec3 r = normalize(w.xyz / w.w);
        rays[i] = r / dot(r, fwd);           // one block of depth along fwd
    }

    // light basis
    vec3 up = abs(l.y) > 0.99 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 right = normalize(cross(up, l));
    vec3 up2 = cross(l, right);

    float near = 0.0;
    for (int c = 0; c < 4; ++c) {
        float far = u_splits[c];
        if (c >= u_cascades) {
            sd.m[c] = mat4(0.0);
            sd.texel[c] = 0.0;
            continue;
        }
        if ((u_update & (1 << c)) == 0) { near = far; continue; }   // kept
        // bounding sphere of the slice: centre on the axis, radius to the
        // farthest corner
        vec3 centre = fwd * (near + far) * 0.5;
        float r = 0.0;
        for (int i = 0; i < 4; ++i) {
            r = max(r, length(rays[i] * near - centre));
            r = max(r, length(rays[i] * far - centre));
        }
        r = ceil(r);
        // snap the centre to whole texels, measured in world space
        float ts = 2.0 * r / u_res;
        vec3 cw = centre + u_cam_mod;
        float cx = dot(cw, right), cy = dot(cw, up2);
        centre += right * (floor(cx / ts) * ts - cx) + up2 * (floor(cy / ts) * ts - cy);
        // light space rows: x, y in [-r, r]; depth 1 (near the light) .. 0
        vec4 row0 = vec4(right / r, -dot(right, centre) / r);
        vec4 row1 = vec4(up2 / r, -dot(up2, centre) / r);
        float zs = 0.5 / DEPTH_RANGE;
        vec4 row2 = vec4(l * zs, -dot(l, centre) * zs + 0.5);
        vec4 row3 = vec4(0.0, 0.0, 0.0, 1.0);
        sd.m[c] = transpose(mat4(row0, row1, row2, row3));
        sd.texel[c] = ts;
        sd.origin[c] = vec4(u_cam_mod, 0.0);
        near = far;
    }
}
