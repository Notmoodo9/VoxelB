; Import definitions for kernel32.dll. build.bat turns this into an import
; library, so no Windows SDK is needed. Add a line for each new import.
LIBRARY kernel32.dll
EXPORTS
    AcquireSRWLockExclusive
    AttachConsole
    CloseHandle
    CreateFileA
    CreateSemaphoreA
    CreateThread
    ExitProcess
    FindClose
    FindFirstFileA
    FindNextFileA
    GetActiveProcessorCount
    GetCommandLineA
    GetFileAttributesA
    GetFileAttributesExA
    GetFileSizeEx
    GetLastError
    GetModuleFileNameA
    GetModuleHandleA
    GetProcAddress
    GetStdHandle
    GetTickCount64
    OutputDebugStringA
    QueryPerformanceCounter
    QueryPerformanceFrequency
    ReadFile
    ReleaseSemaphore
    ReleaseSRWLockExclusive
    SetThreadDescription
    SetThreadPriority
    Sleep
    TlsAlloc
    TlsFree
    TlsGetValue
    TlsSetValue
    VirtualAlloc
    VirtualFree
    WaitForSingleObject
    WriteFile
