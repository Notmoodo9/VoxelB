; Import definitions for user32.dll. build.bat turns this into an import
; library, so no Windows SDK is needed. Add a line for each new import.
LIBRARY user32.dll
EXPORTS
    AdjustWindowRectEx
    CreateWindowExA
    DefWindowProcA
    DestroyWindow
    DispatchMessageA
    GetClientRect
    GetDC
    GetSystemMetrics
    KillTimer
    LoadCursorA
    LoadIconA
    MessageBoxA
    PeekMessageA
    PostMessageA
    PostQuitMessage
    RegisterClassExA
    ReleaseDC
    SetProcessDpiAwarenessContext
    SetTimer
    SetWindowPos
    SetWindowTextA
    ShowWindow
    TranslateMessage
    UnregisterClassA
